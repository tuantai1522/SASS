{
  "ReverseProxy": {
    "Routes": {
      "chat-api": {
        "ClusterId": "chat",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "chat-openapi": {
        "ClusterId": "chat",
        "Match": {
          "Path": "/openapi/{**catch-all}"
        }
      },
      "chat-scalar": {
        "ClusterId": "chat",
        "Match": {
          "Path": "/scalar/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "chat": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5146/"
          }
        }
      }
    }
  }
}
